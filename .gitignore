# 秘匿値（絶対にコミットしない。.env の値を編集するのは統括だけ）
.env
.env.*
*.env
!.env.example

# 鍵・証明書
*.pem
*.pfx
*.key

# Azure CLI / azd のローカル設定
.azure/

# 依存パッケージ
node_modules/

# Python を使う場合（技術スタックの決定後に、要らないものを消す）
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ビルド出力・キャッシュ（技術スタックの決定後に、足りないものを追記）
dist/
# 配備物の zip（前の版の zip を、切り戻しのために手元に残す。Git には入れない）
artifacts/
# 手元で API を動かしたときの保存先（設計 D-12。人数のハッシュだけ。Git には入れない）
/data/
build/
out/
.cache/
coverage/
*.tsbuildinfo

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS の一時ファイル
.DS_Store
Thumbs.db
Desktop.ini
._*

# エディタの一時ファイル
.idea/
.vscode/
*.swp
*~

# Claude Code の個人用の設定
.claude/settings.local.json
