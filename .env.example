# 環境変数の一覧（キー名と意味だけ。値は書かない。.env はコミットしない）。
# Azure では、App Service の「アプリ設定」に同じキーで入れる（設計 D-24）。
# 手元で動かすときは、このファイルを .env にコピーして値を入れ、
#   node --env-file=.env dist/server/server.mjs
# で読み込める（npm run build のあと）。空の行は「未設定」として扱い、既定の値で動く。

# 待ち受けの番号。無ければ 8787。App Service（Linux・Node）が渡す。起動に失敗したときは、アプリ設定の WEBSITES_PORT で合わせる。
PORT=

# 保存先のフォルダ（人数と、端末の番号のハッシュだけを JSON 1 つに保存する）。起動時に作る。無ければ ./data。Azure は /home/data。
DATA_DIR=

# 画面（frontend）の origin。カンマ区切り・完全一致（例の形: https://<画面のホスト名>）。末尾の / は付けない。ワイルドカードは使えない。
CORS_ORIGINS=

# 発表者の合言葉（秘密）。12 文字以上。未設定・12 文字未満だと、reset が 503 で無効になる。値は統括だけが、Azure のアプリ設定に入れる。
PRESENTER_PASSPHRASE=

# 実行環境。Azure は production。未設定のときだけ、開発の画面（http://localhost:5173）も許す。
NODE_ENV=
